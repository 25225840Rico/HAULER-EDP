{# ── PÁGINA 4 · PROPUESTA ECONÓMICA ── #}
<span class="section-label">Propuesta económica</span>
<div class="hero">Precios claros, todo incluido.</div>
<p class="lead mt3">
  Valores en Pesos Chilenos (CLP) netos. Incluyen la totalidad de costos
  operacionales, documentales y de seguros — sin suplementos.
</p>

<div class="pc-grid mt6">
  {% for o in opciones %}
  <div class="pc {% if o.destacada %}pc-blue{% endif %}">
    {% if o.badge %}<span class="badge">{{ o.badge }}</span>{% endif %}
    <div class="pc-name">{{ o.nombre }}{% if o.subtitulo %} · {{ o.subtitulo }}{% endif %}</div>
    <div class="pc-sub">{{ o.subtitulo }}</div>
    <div class="pc-jor">{{ o.jornada }}</div>
    <div class="pc-dot">{{ o.dotacion }}</div>
    <div class="price-label-top">Valor mensual</div>
    <div class="price-num">{{ o.precio | clp }}</div>
    <div class="pc-plabel">{{ o.precio_label }}</div>
    {% if o.features %}
    <div class="pc-feats">
      {% for f in o.features %}<div class="feat">{{ f }}</div>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>

{% if opciones_nota %}
<div class="callout mt6">{{ opciones_nota }}</div>
{% endif %}

{% if opciones | selectattr('comparativo') | list %}
<div class="mt6">
  <h3 class="block-title">Comparativo de opciones</h3>
  <table class="cmp">
    <thead>
      <tr>
        <th>Opción</th><th>Jornada diaria</th><th>Días</th><th>Rotación</th><th>Valor mensual</th>
      </tr>
    </thead>
    <tbody>
      {% for o in opciones %}{% if o.comparativo %}
      <tr>
        <td><b>{{ o.subtitulo }}</b></td>
        <td>{{ o.comparativo.jornada_diaria }}</td>
        <td>{{ o.comparativo.dias }}</td>
        <td>{% if o.comparativo.rotacion %}<span class="yes">Incluida</span>{% else %}—{% endif %}</td>
        <td><b>{{ o.precio | clp }}</b></td>
      </tr>
      {% endif %}{% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
