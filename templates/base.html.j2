<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ numero_cotizacion }}</title>
<style>
  /* ───── TOKENS (inyectados desde config/design.yaml) ───── */
  :root{
    --blue:{{ design.colors.blue }};
    --ink:{{ design.colors.ink }};
    --body:{{ design.colors.body }};
    --muted:{{ design.colors.muted }};
    --line:{{ design.colors.line }};
    --tint:{{ design.colors.tint }};
    --light:{{ design.colors.light }};
    --font:{{ design.font.family | safe }};
    --fs-hero:{{ design.sizes.hero }};
    --fs-section:{{ design.sizes.section }};
    --fs-body:{{ design.sizes.body }};
    --fs-kvk:{{ design.sizes.kv_key }};
    --fs-kvv:{{ design.sizes.kv_value }};
    --fs-price:{{ design.sizes.price }};
    --pad:{{ design.layout.page_padding }};
    --kvw:{{ design.layout.kv_key_width }};
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  @page{ size:A4; margin:0; }

  html,body{ background:#fff; }
  body{
    font-family:var(--font);
    color:var(--body);
    font-size:var(--fs-body);
    line-height:1.5;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

  /* ───── PÁGINA A4 ───── */
  .page{
    position:relative;
    width:210mm; height:297mm;
    background:#fff;
    padding:0 var(--pad) 16mm;
    overflow:hidden;
    page-break-after:always;
  }
  .page:last-child{ page-break-after:auto; }

  .accent-bar{
    position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,#1B5EFF 0%,#6366f1 55%,#e2e8f0 100%);
  }

  /* ───── HEADER ───── */
  .pg-head{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:11mm; padding-bottom:3.5mm;
  }
  .brand{ display:flex; align-items:center; gap:3mm; }
  .brand .mark{ width:11mm; height:11mm; flex:0 0 auto; }
  .brand .bw-title{ font-size:15pt; font-weight:800; letter-spacing:.5px; color:var(--ink); line-height:1; }
  .brand-logo img{ max-height:13mm; max-width:60mm; object-fit:contain; display:block; }
  .pg-meta{ text-align:right; line-height:1.4; }
  .pg-meta .cot{ font-size:8pt; font-weight:800; color:var(--blue); letter-spacing:.5px; display:block; }
  .pg-meta .sec-tag{
    font-size:6pt; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--muted); display:block; margin-top:1mm;
  }
  .pg-meta .date{ font-size:6.5pt; color:var(--muted); display:block; margin-top:.5mm; }

  .rule{ height:1px; background:var(--line); }
  .rule-blue{ height:1.5px; background:var(--blue); }
  .rule-dark{ height:1px; background:var(--ink); opacity:.85; }

  .pg-body{ padding-top:6mm; }

  /* ───── FOOTER ───── */
  .pg-foot{
    position:absolute; left:var(--pad); right:var(--pad); bottom:7mm;
    display:flex; justify-content:space-between; align-items:center;
    font-size:6pt; color:var(--muted); letter-spacing:.4px;
    border-top:1px solid var(--line); padding-top:2.5mm;
  }

  /* ───── TIPOGRAFÍA ───── */
  .section-label{
    display:block; font-size:var(--fs-section); font-weight:700;
    letter-spacing:2.5px; text-transform:uppercase; color:var(--blue);
    margin-bottom:3mm;
  }
  .hero{ font-size:var(--fs-hero); font-weight:800; line-height:1.02; letter-spacing:-.6px; }
  .hero span{ display:block; }
  .hero .l1{ color:var(--ink); }
  .hero .l2{ color:var(--blue); }
  .hero-sub{ font-size:10pt; font-weight:500; color:var(--body); margin-top:3mm; }
  p.lead{ font-size:9pt; color:var(--body); line-height:1.6; max-width:170mm; }
  h3.block-title{
    font-size:7pt; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--blue); margin-bottom:3mm;
  }
  .mt2{margin-top:2mm}.mt3{margin-top:3mm}.mt4{margin-top:4mm}
  .mt5{margin-top:5mm}.mt6{margin-top:6mm}.mt8{margin-top:8mm}.mt10{margin-top:10mm}

  /* ───── TABLA CLAVE-VALOR ───── */
  .kv{ width:100%; border-collapse:collapse; }
  .kv tr:nth-child(even){ background:var(--tint); }
  .kv td{ padding:1.5mm 2.5mm; vertical-align:top; border:0; }
  .kv td.k{ width:var(--kvw); font-size:var(--fs-kvk); color:var(--muted); font-weight:500; }
  .kv td.v{ font-size:var(--fs-kvv); color:var(--ink); font-weight:500; }

  /* ───── GRIDS ───── */
  .col2{ display:grid; grid-template-columns:1fr 1fr; gap:5mm; }
  .col3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:4mm; }

  /* ───── LISTAS ───── */
  .chk,.resp-item,.feat{ position:relative; padding-left:6mm; font-size:8pt; line-height:1.45; margin-bottom:1.6mm; color:var(--body); }
  .chk::before{ content:"✓"; position:absolute; left:0; top:0; color:var(--blue); font-weight:800; }
  .resp-item::before{ content:"●"; position:absolute; left:0; top:1.5px; color:var(--blue); font-size:6pt; }
  .feat::before{ content:"—"; position:absolute; left:0; top:0; color:var(--blue); font-weight:700; }
  .chk b{ color:var(--ink); font-weight:700; }

  /* ───── CALLOUTS ───── */
  .callout{
    background:#f8fafc; border-left:3px solid var(--blue); border-radius:0 8px 8px 0;
    padding:4mm 4.5mm; font-size:8.5pt; color:var(--body); line-height:1.55;
  }
  .callout-blue{
    background:#eff6ff; border-left:3px solid var(--blue); border-radius:0 8px 8px 0;
    padding:4mm 4.5mm; font-size:8.5pt; color:#1e40af; line-height:1.55;
  }
  .callout-blue b{ color:#1e3a8a; font-weight:700; }

  /* ───── STAT CARDS ───── */
  .stats{ display:grid; grid-template-columns:repeat(5,1fr); gap:3mm; }
  .stat{ border:1px solid var(--line); border-radius:8px; background:var(--tint); padding:4mm 3mm; text-align:center; }
  .stat .s-val{ font-size:15pt; font-weight:800; color:var(--ink); line-height:1; }
  .stat .s-lab{ font-size:6pt; color:var(--muted); margin-top:2mm; line-height:1.3; }

  /* ───── PRICE CARDS ───── */
  .pc-grid{ display:grid; grid-template-columns:1fr 1fr; gap:6mm; align-items:start; }
  .pc{ border:1px solid var(--line); border-radius:12px; padding:6mm; position:relative; background:#fff; }
  .pc-blue{ border:1.5px solid var(--blue); background:var(--light); }
  .pc .pc-name{ font-size:6.5pt; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--blue); }
  .pc .pc-jor{ font-size:10pt; font-weight:800; color:var(--ink); margin-top:2mm; }
  .pc .pc-dot{ font-size:7.5pt; color:var(--muted); margin-top:1.5mm; }
  .pc .pc-div{ height:1px; background:var(--line); margin:4mm 0; }
  .pc .price-label-top{ font-size:6pt; font-weight:700; letter-spacing:1.8px; text-transform:uppercase; color:var(--blue); }
  .price-num{ font-size:var(--fs-price); font-weight:800; color:var(--blue); line-height:1; letter-spacing:-1px; margin-top:2mm; }
  .pc .pc-plabel{ font-size:6.5pt; color:var(--muted); margin-top:2mm; }
  .pc .pc-feats{ margin-top:1mm; }
  .badge{
    position:absolute; top:-3mm; right:5mm;
    background:var(--blue); color:#fff; font-size:6pt; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase; padding:1.6mm 3.5mm; border-radius:20px;
  }

  /* ───── NORMATIVA ───── */
  .norm-strip{ display:flex; flex-wrap:wrap; gap:2mm; }
  .norm-strip .chip{ border:1px solid var(--line); border-radius:20px; padding:1.5mm 3.5mm; font-size:6.5pt; color:var(--body); background:#fff; }

  /* ───── TABLA COMPARATIVA ───── */
  .cmp{ width:100%; border-collapse:collapse; font-size:7.5pt; }
  .cmp th{ text-align:left; font-size:6.5pt; text-transform:uppercase; letter-spacing:1px; color:var(--blue); font-weight:700; padding:2.5mm; border-bottom:1.5px solid var(--blue); }
  .cmp th.num,.cmp td.num{ text-align:center; }
  .cmp td{ padding:2.5mm; border-bottom:1px solid var(--line); color:var(--ink); }
  .cmp tr:last-child td{ border-bottom:0; }
  .cmp .yes{ color:var(--blue); font-weight:700; }
  .cmp .price{ color:var(--blue); font-weight:700; }

  /* ───── VEHÍCULO ───── */
  .veh-head .veh-name{ font-size:13pt; font-weight:800; color:var(--ink); line-height:1; }
  .veh-head .veh-meta{ font-size:7.5pt; color:var(--blue); margin-top:1.5mm; font-weight:600; }

  /* ───── FIRMA ───── */
  .sign-cols{ display:grid; grid-template-columns:1.55fr 1fr; gap:6mm; align-items:stretch; }
  .card{ border:1px solid var(--line); border-radius:12px; padding:6mm; }
  .card .c-name{ font-size:11pt; font-weight:800; color:var(--ink); margin-top:1mm; }
  .card .c-role{ font-size:8pt; color:var(--blue); font-weight:600; margin-top:1mm; margin-bottom:3mm; }
  .card .c-note{ font-size:6.5pt; color:var(--muted); line-height:1.5; margin-top:3mm; }
  a, .link{ color:var(--blue); text-decoration:none; }

  .sign-img{ max-height:16mm; max-width:48mm; object-fit:contain; display:block; margin:2mm 0 1mm; }
  .sign-slot{ min-height:18mm; display:flex; align-items:flex-end; }
  .sign-line{ border-top:1px solid var(--ink); margin-top:2mm; }
  .sign-cap{ font-size:6.5pt; color:var(--muted); margin-top:1.5mm; line-height:1.4; }

  .accept-grid{ display:grid; grid-template-columns:1fr 1.4fr; gap:8mm; }
  .field-line{ border-bottom:1px solid var(--ink); height:8mm; }
  .field-cap{ font-size:6.5pt; color:var(--muted); margin-top:1.5mm; }
  .opts{ display:flex; gap:8mm; flex-wrap:wrap; align-items:center; }
  .opt{ display:flex; align-items:center; gap:2mm; font-size:7.5pt; color:var(--ink); }
  .opt .circle{ width:3.5mm; height:3.5mm; border:1.2px solid var(--blue); border-radius:50%; flex:0 0 auto; }
</style>
</head>
<body>
{% for page in pages %}
  <section class="page">
    <span class="accent-bar"></span>
    <header class="pg-head">
      {% if logo_data_uri %}
        <div class="brand-logo"><img src="{{ logo_data_uri }}" alt="{{ empresa.nombre }}"></div>
      {% else %}
        <div class="brand">
          <svg class="mark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g transform="skewX(-11)">
              <rect x="20" y="12" width="15" height="76" rx="3" fill="{{ design.colors.blue }}"/>
              <rect x="42" y="12" width="15" height="76" rx="3" fill="{{ design.colors.ink }}"/>
              <rect x="64" y="12" width="11" height="76" rx="3" fill="{{ design.colors.blue }}"/>
            </g>
          </svg>
          <span class="bw-title">{{ empresa.brand_title }}</span>
        </div>
      {% endif %}
      <div class="pg-meta">
        <span class="cot">{{ numero_cotizacion }}</span>
        <span class="sec-tag">{{ page.tag }}</span>
        {% if loop.first %}<span class="date">{{ fecha_fmt }}</span>{% endif %}
      </div>
    </header>
    <div class="rule"></div>
    <main class="pg-body">
      {% include 'sections/' ~ page.template %}
    </main>
    <footer class="pg-foot">
      <span>
        {%- if page.foot_kind == 'brand' -%}{{ empresa.footer }}
        {%- elif page.foot_kind == 'confidential' -%}Propuesta confidencial · {{ cliente.razon_social }} · {{ numero_cotizacion }}
        {%- else -%}{{ empresa.nombre }} · {{ numero_cotizacion }}{%- endif -%}
      </span>
      <span>{{ loop.index }} / {{ pages|length }}</span>
    </footer>
  </section>
{% endfor %}
</body>
</html>
