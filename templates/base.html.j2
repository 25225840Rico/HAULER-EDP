<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ numero_cotizacion }}</title>
<style>
  /* ───── TOKENS (inyectados desde config/design.yaml) ───── */
  :root{
    --blue:{{ design.colors.blue }};
    --ink:{{ design.colors.ink }};
    --body:{{ design.colors.body }};
    --muted:{{ design.colors.muted }};
    --line:{{ design.colors.line }};
    --tint:{{ design.colors.tint }};
    --light:{{ design.colors.light }};
    --font:{{ design.font.family }};
    --fs-hero:{{ design.sizes.hero }};
    --fs-section:{{ design.sizes.section }};
    --fs-body:{{ design.sizes.body }};
    --fs-kvk:{{ design.sizes.kv_key }};
    --fs-kvv:{{ design.sizes.kv_value }};
    --fs-price:{{ design.sizes.price }};
    --pad:{{ design.layout.page_padding }};
    --kvw:{{ design.layout.kv_key_width }};
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  @page{ size:A4; margin:0; }

  html,body{ background:#fff; }
  body{
    font-family:var(--font);
    color:var(--body);
    font-size:var(--fs-body);
    line-height:1.65;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

  /* ───── PÁGINA A4 ───── */
  .page{
    position:relative;
    width:210mm;
    height:297mm;
    background:#fff;
    padding:0 var(--pad) 16mm;
    overflow:hidden;
    page-break-after:always;
  }
  .page:last-child{ page-break-after:auto; }

  /* Barra de acento superior */
  .accent-bar{
    position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,#1B5EFF 0%,#6366f1 55%,#e2e8f0 100%);
  }

  /* Header */
  .pg-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    padding-top:11mm; padding-bottom:3mm;
  }
  .brand-wordmark .bw-title{
    font-size:15pt; font-weight:800; letter-spacing:-.4px; color:var(--ink); line-height:1;
  }
  .brand-wordmark .bw-sub{
    font-size:5.2pt; font-weight:600; letter-spacing:2px; text-transform:uppercase;
    color:var(--muted); margin-top:2.5px;
  }
  .brand-logo img{ max-height:13mm; max-width:55mm; object-fit:contain; display:block; }
  .pg-meta{ text-align:right; line-height:1.35; }
  .pg-meta .cot{ font-size:7pt; font-weight:700; color:var(--ink); letter-spacing:.5px; display:block; }
  .pg-meta .sec-tag{
    font-size:6pt; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--blue); display:block; margin-top:2px;
  }

  .rule{ height:1px; background:var(--line); }
  .rule-blue{ height:1px; background:var(--blue); opacity:.55; }
  .rule-dark{ height:1px; background:var(--ink); opacity:.35; }

  /* Cuerpo */
  .pg-body{ padding-top:7mm; }

  /* Footer */
  .pg-foot{
    position:absolute; left:var(--pad); right:var(--pad); bottom:7mm;
    display:flex; justify-content:space-between; align-items:center;
    font-size:6pt; color:var(--muted); letter-spacing:.4px;
    border-top:1px solid var(--line); padding-top:2.5mm;
  }

  /* ───── TIPOGRAFÍA ───── */
  .section-label{
    display:block; font-size:var(--fs-section); font-weight:700;
    letter-spacing:2.5px; text-transform:uppercase; color:var(--blue);
    margin-bottom:3mm;
  }
  .hero{ font-size:var(--fs-hero); font-weight:800; color:var(--ink); line-height:1.0; letter-spacing:-.5px; }
  .hero-sub{ font-size:10pt; font-weight:600; color:var(--body); margin-top:2.5mm; }
  h3.block-title{
    font-size:7pt; font-weight:700; letter-spacing:2px; text-transform:uppercase;
    color:var(--muted); margin-bottom:2.5mm;
  }
  p.lead{ font-size:9pt; color:var(--body); line-height:1.6; }
  .mt2{ margin-top:2mm; } .mt3{ margin-top:3mm; } .mt4{ margin-top:4mm; }
  .mt6{ margin-top:6mm; } .mt8{ margin-top:8mm; }

  /* ───── TABLA CLAVE-VALOR ───── */
  .kv{ width:100%; border-collapse:collapse; }
  .kv tr:nth-child(even){ background:var(--tint); }
  .kv td{ padding:2mm 2.5mm; vertical-align:top; border:0; }
  .kv td.k{ width:var(--kvw); font-size:var(--fs-kvk); color:var(--muted); font-weight:500; }
  .kv td.v{ font-size:var(--fs-kvv); color:var(--ink); font-weight:500; }

  /* ───── GRIDS ───── */
  .col2{ display:grid; grid-template-columns:1fr 1fr; gap:5mm; }
  .col3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:4mm; }

  /* ───── LISTAS ───── */
  .chk, .resp-item, .feat{ position:relative; padding-left:6mm; font-size:8pt; line-height:1.55; margin-bottom:2mm; }
  .chk::before{ content:"✓"; position:absolute; left:0; top:0; color:var(--blue); font-weight:800; }
  .resp-item::before{ content:"●"; position:absolute; left:0; top:0; color:var(--blue); font-size:6pt; top:1.5px; }
  .feat::before{ content:"—"; position:absolute; left:0; top:0; color:var(--blue); font-weight:700; }
  .chk b{ color:var(--ink); font-weight:700; }

  /* ───── CALLOUTS ───── */
  .callout{
    background:#f8fafc; border-left:3px solid var(--blue); border-radius:0 8px 8px 0;
    padding:3.5mm 4mm; font-size:8.5pt; color:var(--body); line-height:1.55;
  }
  .callout-blue{
    background:#eff6ff; border-left:3px solid var(--blue); border-radius:0 8px 8px 0;
    padding:3.5mm 4mm; font-size:8.5pt; color:#1e40af; line-height:1.55;
  }

  /* ───── STAT CARDS ───── */
  .stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:4mm; }
  .stat{ border:1px solid #f1f5f9; border-radius:8px; background:var(--tint); padding:4mm; }
  .stat .s-val{ font-size:18pt; font-weight:800; color:var(--blue); line-height:1; }
  .stat .s-lab{ font-size:6.5pt; color:var(--muted); margin-top:2mm; line-height:1.3; text-transform:uppercase; letter-spacing:.6px; }

  /* ───── PRICE CARDS ───── */
  .pc-grid{ display:grid; grid-template-columns:1fr 1fr; gap:5mm; align-items:start; }
  .pc{ border:1px solid var(--line); border-radius:12px; padding:5mm; position:relative; background:#fff; }
  .pc-blue{ border:1.5px solid var(--blue); background:var(--light); }
  .pc .pc-name{ font-size:6.5pt; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--blue); }
  .pc .pc-sub{ font-size:12pt; font-weight:800; color:var(--ink); margin-top:1mm; }
  .pc .pc-jor{ font-size:7.5pt; color:var(--body); margin-top:1.5mm; }
  .pc .pc-dot{ font-size:7pt; color:var(--muted); margin-top:.8mm; }
  .pc .price-label-top{ font-size:6pt; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); margin-top:4mm; }
  .price-num{ font-size:var(--fs-price); font-weight:800; color:var(--blue); line-height:1; letter-spacing:-1px; }
  .pc .pc-plabel{ font-size:6.5pt; color:var(--muted); margin-top:1mm; }
  .pc .pc-feats{ margin-top:4mm; }
  .badge{
    position:absolute; top:-3mm; right:4mm;
    background:var(--blue); color:#fff; font-size:6pt; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase; padding:1.5mm 3mm; border-radius:20px;
  }

  /* Strip de normativa */
  .norm-strip{ display:flex; flex-wrap:wrap; gap:2mm; }
  .norm-strip .chip{
    border:1px solid var(--line); border-radius:20px; padding:1.5mm 3.5mm;
    font-size:6.5pt; color:var(--body); background:#fff;
  }

  /* Tabla comparativa */
  .cmp{ width:100%; border-collapse:collapse; font-size:7.5pt; }
  .cmp th{ text-align:left; font-size:6.5pt; text-transform:uppercase; letter-spacing:1px; color:var(--muted); font-weight:700; padding:2.5mm; border-bottom:1px solid var(--line); }
  .cmp td{ padding:2.5mm; border-bottom:1px solid var(--line); color:var(--ink); }
  .cmp tr:last-child td{ border-bottom:0; }
  .cmp .yes{ color:var(--blue); font-weight:700; }

  /* Vehículo header */
  .veh-head .veh-name{ font-size:16pt; font-weight:800; color:var(--ink); line-height:1; }
  .veh-head .veh-meta{ font-size:7.5pt; color:var(--muted); margin-top:1.5mm; }

  /* Firma */
  .sign-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10mm; margin-top:14mm; }
  .sign-box{ text-align:center; }
  .sign-line{ border-top:1px solid var(--ink); margin-bottom:2mm; }
  .sign-box .s-name{ font-size:8.5pt; font-weight:700; color:var(--ink); }
  .sign-box .s-role{ font-size:7pt; color:var(--muted); margin-top:1mm; }
  .legal{ font-size:6.5pt; color:var(--muted); line-height:1.5; }
</style>
</head>
<body>
{% for page in pages %}
  <section class="page">
    <span class="accent-bar"></span>
    <header class="pg-head">
      {% if logo_data_uri %}
        <div class="brand-logo"><img src="{{ logo_data_uri }}" alt="{{ empresa.nombre }}"></div>
      {% else %}
        <div class="brand-wordmark">
          <div class="bw-title">{{ empresa.brand_title }}</div>
          <div class="bw-sub">{{ empresa.brand_sub }}</div>
        </div>
      {% endif %}
      <div class="pg-meta">
        <span class="cot">{{ numero_cotizacion }}</span>
        <span class="sec-tag">{{ page.tag }}</span>
      </div>
    </header>
    <div class="rule"></div>
    <main class="pg-body">
      {% include 'sections/' ~ page.template %}
    </main>
    <footer class="pg-foot">
      <span>{{ empresa.footer }}</span>
      <span>{{ loop.index }}/{{ pages|length }}</span>
    </footer>
  </section>
{% endfor %}
</body>
</html>
